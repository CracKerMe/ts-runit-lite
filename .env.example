# ===========================================
# 工作流引擎配置文件（精简版：单进程部署）
# 复制此文件为 .env 并根据需要修改
# ===========================================

# ----- 工作流引擎配置 -----
# 日志级别: DEBUG, INFO, WARN, ERROR
WORKFLOW_ENGINE_LOG_LEVEL=INFO
LOG_LEVEL=info
# 日志不再输出到控制台，按天写入 LOG_DIR 下的 YYYY-MM-DD.log 文件
LOG_DIR=./logs
# 日志文件保留天数，超过后自动删除；<=0 表示不清理
LOG_RETENTION_DAYS=30
# 最大实例数
WORKFLOW_ENGINE_MAX_INSTANCES=1000
# 已完成实例保留时间（小时）
INSTANCE_TTL_HOURS=24
# 清理间隔（毫秒），默认 1 小时
CLEANUP_INTERVAL_MS=3600000

# ----- 存储配置 -----
# file 为非测试环境默认值，提供进程重启恢复；memory 适合测试和完全临时任务
STORAGE_TYPE=file
# 热数据目录：每条记录一个 JSON 文件，通过临时文件 + 原子 rename 写入
# 内含 instances、workflows、workflow-metadata、workflow-versions、waiting、
# metrics、events、heartbeats、dlq 等分类目录；损坏记录会隔离到各目录的 corrupt/
# 该目录只能由一个引擎进程使用，禁止多个进程共享同一 STORAGE_DIR
# 建议停机后备份整个目录，避免跨分类文件处于不同写入时点
STORAGE_DIR=.ts-runit-data
# 默认 false：原子 rename 只保证"读到的文件一定是完整的"，不保证内容已落盘，
# 主机级崩溃/断电仍可能丢失最近写入。设为 true 后每次写入会 fsync 临时文件
# 和所在目录，换取主机级故障下的持久性，代价是写入延迟明显增加
FSYNC_ON_WRITE=false

# ----- 实例归档 -----
# 默认关闭。启用后，终态实例先写入 archive/YYYY-MM-DD/<instanceId>.json，
# 写入成功后再从热存储移除；归档文件不会自动出现在实例查询或恢复流程中
ARCHIVE_ENABLED=false
# 归档目录应与 STORAGE_DIR 分开备份
# ARCHIVE_DIR=./archive
# 按日期目录保留归档的天数；过期日期目录会被整体删除
ARCHIVE_RETENTION_DAYS=90
# 启动时会清理一次，之后按此周期清理，默认 6 小时
ARCHIVE_CLEANUP_INTERVAL_MS=21600000

# ----- API 服务器配置 -----
# 是否启动 API 服务器
START_API_SERVER=false
# API 服务器端口
API_PORT=3345
# 是否在启动时恢复未完成实例（仅 API 模式读取，默认启用）
# JSON/配置型工作流可直接恢复。包含 JS 函数或闭包的工作流无法写入磁盘；
# 此类工作流应先设为 false，启动后重新 register，再调用
# engine.resumeRunningInstancesFromStorage()
RESUME_ON_STARTUP=true
# Webhook delivery 后台清理周期（毫秒），默认继承 CLEANUP_INTERVAL_MS
WEBHOOK_DELIVERY_CLEANUP_INTERVAL_MS=3600000

# ----- 实例执行租约 -----
# 实例执行租约 TTL（毫秒），单进程内用于防止同一实例重复执行
INSTANCE_LEASE_TTL_MS=30000

# ----- 认证配置 -----
# 是否启用 API 认证
AUTH_ENABLED=false
# JWT 密钥（启用认证时必须设置，至少 32 字符）
JWT_SECRET=your-super-secret-jwt-key-at-least-32-chars
# API Key（可选的简单认证方式）
API_KEY=your-api-key-here
# API Key 用户的默认角色: admin | operator | viewer
API_KEY_ROLE=operator
# API Key 用户的默认 ID
API_KEY_USER_ID=api-key-service

# ----- 安全配置（生产环境）-----
# CORS 允许的源（逗号分隔），生产环境必须设置
# CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://app.yourdomain.com
# JSON body 大小限制
# JSON_BODY_LIMIT=1mb

# ----- 限流配置（单进程内存限流）-----
# 是否启用请求限流
RATE_LIMIT_ENABLED=true
# 限流时间窗口（毫秒）
RATE_LIMIT_WINDOW_MS=60000
# 时间窗口内最大请求数
RATE_LIMIT_MAX_REQUESTS=100

# ----- 并发控制配置 -----
# 最大并发实例数
MAX_CONCURRENT_INSTANCES=100
# 每个实例最大并发节点数
MAX_CONCURRENT_NODES=10
# 锁超时时间（毫秒）
LOCK_TIMEOUT_MS=30000

# ----- 事件去重配置 -----
# 事件去重 TTL（秒）
EVENT_DEDUP_TTL_SECONDS=86400

# ----- 审计日志配置 -----
# 是否启用审计日志
AUDIT_LOG_ENABLED=true

# ----- Worker 线程池配置 -----
# 是否启用 worker 线程池（将 http 节点卸载到独立线程执行）
WORKER_POOL_ENABLED=false
# 最小/最大 worker 数量
WORKER_POOL_MIN=2
WORKER_POOL_MAX=8
# 单个任务超时时间（毫秒）
WORKER_POOL_TASK_TIMEOUT_MS=60000
# worker 空闲回收时间（毫秒）
WORKER_POOL_IDLE_TIMEOUT_MS=300000

# ----- Sticky 亲和性配置（仅在 worker 池启用时生效）-----
# 是否把同一实例的后续任务路由回同一个 worker
WORKER_STICKY_ENABLED=true
# 每个 sticky worker 的最大缓存条目数
WORKER_STICKY_CACHE_SIZE=100
# sticky 绑定的存活时间（毫秒）
WORKER_STICKY_TTL_MS=60000

# ----- 密钥管理配置 -----
# 密钥后端：env（默认，从环境变量读取）；vault / aws-secrets-manager 尚未实现，
# 配置后会在启动时直接抛错，而不是静默回退到环境变量。
# 节点配置中可使用 ${secret:NAME} 引用密钥，在 http/sql/queue 节点执行前解析。
SECRET_PROVIDER=env

# ----- CLI 工具链（@ts-runit/cli）-----
# CLI 连接的 API 服务器地址（默认 http://localhost:3345）
# RUNIT_SERVER=http://localhost:3345
# CLI 认证令牌
# RUNIT_TOKEN=your-auth-token
